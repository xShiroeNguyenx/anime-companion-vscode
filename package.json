{
  "name": "anime-companion-vscode",
  "displayName": "Anime Companion",
  "description": "🌸 Live2D anime companion in your sidebar — reacts to errors, saves, commits, builds, debug & Pomodoro. Multilingual voice + lip-sync.",
  "version": "0.1.25",
  "publisher": "shiroenguyen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xShiroeNguyenx/anime-companion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/xShiroeNguyenx/anime-companion-vscode/issues"
  },
  "homepage": "https://github.com/xShiroeNguyenx/anime-companion-vscode#readme",
  "qna": "marketplace",
  "keywords": [
    "anime",
    "companion",
    "mascot",
    "live2d",
    "waifu",
    "vtuber",
    "pomodoro",
    "productivity",
    "fun",
    "motivation",
    "kawaii",
    "pet",
    "buddy",
    "azur lane",
    "voicevox"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#FFD6E7",
    "theme": "light"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "animeCompanion.show",
        "title": "Anime Companion: Show"
      },
      {
        "command": "animeCompanion.hide",
        "title": "Anime Companion: Hide Companion",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.toggle",
        "title": "Anime Companion: Toggle"
      },
      {
        "command": "animeCompanion.changeModel",
        "title": "Anime Companion: Change Model",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.changeVoice",
        "title": "Anime Companion: Change Voice",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.changeMessageLanguage",
        "title": "Anime Companion: Change Message Language",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.toggleMute",
        "title": "Anime Companion: Toggle Mute",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.startPomodoro",
        "title": "Anime Companion: Start Pomodoro",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.stopPomodoro",
        "title": "Anime Companion: Stop Pomodoro",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.openSettings",
        "title": "Anime Companion: Open Settings",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.showStats",
        "title": "Anime Companion: Show Stats",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.showAchievements",
        "title": "Anime Companion: Show Achievements",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.playMotion",
        "title": "Anime Companion: Play Motion",
        "category": "Anime Companion"
      },
      {
        "command": "animeCompanion.resetWorkspaceModel",
        "title": "Anime Companion: Reset Workspace Model",
        "category": "Anime Companion"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "animeCompanionPanel",
          "title": "🌸 Anime Companion",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "animeCompanionPanel": [
        {
          "type": "webview",
          "id": "animeCompanion.live2dView",
          "name": "Anime Companion",
          "when": "animeCompanion.visible"
        }
      ]
    },
    "configuration": {
      "title": "Anime Companion",
      "properties": {
        "animeCompanion.messageIntervalMin": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 120,
          "description": "Minimum interval (in seconds) between random messages."
        },
        "animeCompanion.pomodoroWorkTime": {
          "type": "number",
          "default": 25,
          "description": "Work duration for Pomodoro in minutes."
        },
        "animeCompanion.pomodoroBreakTime": {
          "type": "number",
          "default": 5,
          "description": "Break duration for Pomodoro in minutes."
        },
        "animeCompanion.messageIntervalMax": {
          "type": "number",
          "default": 20,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum interval (seconds) between random messages."
        },
        "animeCompanion.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the companion when VS Code starts."
        },
        "animeCompanion.characterSize": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "default": "medium",
          "description": "Size of the companion character."
        },
        "animeCompanion.model": {
          "type": "string",
          "enum": [
            "hiyori",
            "haru",
            "mao",
            "miara",
            "cheshire",
            "icegirl",
            "tsubaki",
            "whiteangel",
            "vivian",
            "changli"
          ],
          "enumDescriptions": [
            "Hiyori (Live2D Sample) — Cute schoolgirl",
            "Haru (Live2D Sample) — Greeter girl",
            "Mao (Live2D Sample) — Cat-eared shrine girl",
            "Miara (Live2D Sample) — Magical girl",
            "Cheshire (Azur Lane) — experimental, requires animeCompanion.experimentalModels",
            "Ice Girl (TianYeLuLu) — experimental, requires animeCompanion.experimentalModels",
            "Tsubaki (11月椿) — experimental, requires animeCompanion.experimentalModels",
            "White Angel (白发天使) — experimental, requires animeCompanion.experimentalModels",
            "Vivian (薇薇安) — experimental, requires animeCompanion.experimentalModels",
            "Changli (长离) — experimental, requires animeCompanion.experimentalModels"
          ],
          "default": "hiyori",
          "description": "Choose the Live2D character model. Models marked 'experimental' are hidden from the inline picker unless `animeCompanion.experimentalModels` is enabled."
        },
        "animeCompanion.experimentalModels": {
          "type": "boolean",
          "default": false,
          "description": "Show experimental Live2D models (Azur Lane, Wuthering Waves, fan-made) in the picker. These assets do not have explicit redistribution rights for the Marketplace — use only locally. See LICENSE-AUDIT.md."
        },
        "animeCompanion.voiceLanguage": {
          "type": "string",
          "enum": [
            "ja",
            "vi",
            "en"
          ],
          "enumDescriptions": [
            "Japanese (anime-style VoiceVox voice)",
            "Tiếng Việt (Giọng Google TTS)",
            "English (audio generated with Google TTS)"
          ],
          "default": "ja",
          "description": "Choose the voice language for the companion (audio only)."
        },
        "animeCompanion.messageLanguage": {
          "type": "string",
          "enum": [
            "vi",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "Tiếng Việt",
            "English",
            "日本語"
          ],
          "default": "vi",
          "description": "Choose the language for bubble text (idle/reactive messages, achievements). Independent from voice."
        },
        "animeCompanion.muted": {
          "type": "boolean",
          "default": false,
          "description": "Mute all companion audio playback."
        },
        "animeCompanion.breakReminderMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 120,
          "description": "Minutes of continuous coding before break reminder."
        },
        "animeCompanion.reactive.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "React to errors and warnings (problems panel changes)."
        },
        "animeCompanion.reactive.save": {
          "type": "boolean",
          "default": true,
          "description": "React when files are saved (including spam-save detection)."
        },
        "animeCompanion.reactive.typing": {
          "type": "boolean",
          "default": true,
          "description": "React to typing speed and keyword Easter eggs (TODO/FIXME/console.log)."
        },
        "animeCompanion.reactive.git": {
          "type": "boolean",
          "default": true,
          "description": "Poll Git state to react to branch switches, commits, merge conflicts, and many uncommitted changes."
        },
        "animeCompanion.quietHours": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{1,2}:\\d{2}\\s*-\\s*\\d{1,2}:\\d{2}$"
          },
          "default": [],
          "description": "Time ranges (24h format \"HH:MM-HH:MM\") during which all bubble messages are suppressed. Example: [\"09:00-12:00\", \"22:00-06:00\"]. Mood/expression updates still happen — only messages are muted."
        },
        "animeCompanion.customPhrases.idle": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra idle bubble phrases. Merged into the default idle pool for the active language."
        },
        "animeCompanion.customPhrases.save": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra phrases shown after a successful save. Merged into the default save pool."
        },
        "animeCompanion.customPhrases.error": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra phrases shown when new errors appear. Merged into the default error pool."
        },
        "animeCompanion.modelDownloadBaseUrl": {
          "type": "string",
          "default": "https://github.com/xShiroeNguyenx/anime-companion-vscode/releases/download/models-v1",
          "description": "Base URL where lazy-loaded Live2D model zips are hosted. Each model is fetched as `{baseUrl}/{folder}.zip` (e.g. Vivian.zip). Override if you self-host."
        },
        "animeCompanion.customKeywords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "description": "User-defined keyword reactions. Each key is a substring (case-insensitive) to watch for in typed text; the value is a pool of messages picked when matched. Example: { \"NOTE\": [\"Ghi chú thêm rồi nha~\"], \"refactor\": [\"Refactor là yêu lắm đó!\"] }."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node ./scripts/smoke-test.js",
    "cleanup:vsix": "node scripts/cleanup-vsix.js",
    "package": "vsce package --allow-missing-repository && npm run cleanup:vsix",
    "package:install": "vsce package --allow-missing-repository && npm run cleanup:vsix && \"%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code.cmd\" --install-extension \"%npm_package_name%-%npm_package_version%.vsix\" --force",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish \"%npm_package_name%-%npm_package_version%.vsix\""
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^2.19.0",
    "eslint": "^8.57.1",
    "ovsx": "^0.10.11",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "undici": "5.28.4"
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}
