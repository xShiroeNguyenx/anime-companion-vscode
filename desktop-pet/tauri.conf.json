{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anime Companion Pet",
  "version": "0.1.0",
  "identifier": "com.shiroenguyen.anime-companion-pet",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "desktop-pet-remote-drag",
          "description": "Allow the localhost Desktop Companion webview to drag the floating window.",
          "remote": {
            "urls": [
              "http://127.0.0.1:*",
              "http://localhost:*"
            ]
          },
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging"
          ],
          "platforms": [
            "windows"
          ]
        }
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": false
  }
}
