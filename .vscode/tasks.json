{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Install No Bump",
      "type": "shell",
      "command": "bash",
      "args": [
        "./build-install.sh",
        "--no-bump"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "detail": "Run build-install.sh without changing package version"
    },
    {
      "label": "Rebuild & Install Extension",
      "type": "npm",
      "script": "package:install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "detail": "Build .vsix and reinstall via code --install-extension"
    }
  ]
}
